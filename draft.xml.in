<front>

<title abbrev="EPP DELEG Extension">
Extensible Provisioning Protocol (EPP) mapping for DELEG records
</title>

<seriesInfo
  value="draft-brown-epp-deleg-02"
  stream="independent"
  status="informational"
  name="Internet-Draft"/>

<author initials="G." surname="Brown" fullname="Gavin Brown">
